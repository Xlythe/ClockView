<!--
    Ranged values on arc slots, one case per band, for the screenshot goldens. The bands run clockwise
    from the top; the label in the middle says what each is fed. See ../../README.md.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Scene backgroundColor="#FF000000">
        <PartText x="75" y="150" width="300" height="36">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="MEDIUM" color="#FFFFFFFF">RANGED VALUES</Font>
            </Text>
        </PartText>
        <PartText x="75" y="194" width="300" height="32">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="22" weight="NORMAL" color="#FFB0B0B0">top  0%</Font>
            </Text>
        </PartText>
        <PartText x="75" y="224" width="300" height="32">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="22" weight="NORMAL" color="#FFB0B0B0">right  15%</Font>
            </Text>
        </PartText>
        <PartText x="75" y="254" width="300" height="32">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="22" weight="NORMAL" color="#FFB0B0B0">bottom  60%</Font>
            </Text>
        </PartText>
        <PartText x="75" y="284" width="300" height="32">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="22" weight="NORMAL" color="#FFB0B0B0">left  100%</Font>
            </Text>
        </PartText>

        <!-- Top: 0% -->
        <com.xlythe.ComplicationSlot slotId="1" x="0" y="0" width="450" height="450" type="arc"
            startAngle="325" endAngle="35" complicationDrawableStyle="line"
            defaultProvider="EMPTY" defaultProviderType="EMPTY"
            primaryProvider="com.xlythe.watchface.screenshots.provider/com.xlythe.watchface.screenshots.provider.Sources$Ranged0"
            primaryProviderType="RANGED_VALUE" />

        <!-- Right: 15% -->
        <com.xlythe.ComplicationSlot slotId="2" x="0" y="0" width="450" height="450" type="arc"
            startAngle="55" endAngle="125" complicationDrawableStyle="line"
            defaultProvider="EMPTY" defaultProviderType="EMPTY"
            primaryProvider="com.xlythe.watchface.screenshots.provider/com.xlythe.watchface.screenshots.provider.Sources$Ranged15"
            primaryProviderType="RANGED_VALUE" />

        <!-- Bottom: 60% -->
        <com.xlythe.ComplicationSlot slotId="3" x="0" y="0" width="450" height="450" type="arc"
            startAngle="145" endAngle="215" complicationDrawableStyle="line"
            defaultProvider="EMPTY" defaultProviderType="EMPTY"
            primaryProvider="com.xlythe.watchface.screenshots.provider/com.xlythe.watchface.screenshots.provider.Sources$Ranged60"
            primaryProviderType="RANGED_VALUE" />

        <!-- Left: 100% -->
        <com.xlythe.ComplicationSlot slotId="4" x="0" y="0" width="450" height="450" type="arc"
            startAngle="235" endAngle="305" complicationDrawableStyle="line"
            defaultProvider="EMPTY" defaultProviderType="EMPTY"
            primaryProvider="com.xlythe.watchface.screenshots.provider/com.xlythe.watchface.screenshots.provider.Sources$Ranged100"
            primaryProviderType="RANGED_VALUE" />
    </Scene>
</WatchFace>
