<!--
    A round or oblong complication, drawn as a ring with the provider's data inside it.

    Every complication type gets its own layout, because every type hands over something different:
    SHORT_TEXT has a string and a qualifier, RANGED_VALUE has a number between two bounds,
    WEIGHTED_ELEMENTS has a list. A layout that asks a type for something it does not carry draws
    nothing, so each one asks only for what its type is documented to provide.

    The com.xlythe.* tags below are expanded by ComplicationSlotExpander, which knows the slot's
    size and colors. An area names where something goes and a scale how big it is, so this file is
    about arrangement and the geometry stays in one place.

    Where a provider gives several things at once, the order of the Compare blocks decides what
    wins: the first one whose expression holds is the one drawn. Wear's guidance is to show an icon
    or a title but not both, so the pairings come before the singles and the icon pairing comes
    first.

    Type follows one rule throughout. A value is set large where the runtime can shrink it to fit
    its box (format 3 on) and medium where it can only ellipsize, so "72°" is as big as the chip
    allows and "10,482" still fits; a label is set small and held back; and nothing is set below
    small, because on a chip a sixth the width of the face, small is already the least that can be
    read.
-->
<ComplicationSlot slotId="${COMPLICATION_ID}" x="${POS_X}" y="${POS_Y}" width="${WIDTH}" height="${HEIGHT}" supportedTypes="EMPTY SHORT_TEXT LONG_TEXT RANGED_VALUE GOAL_PROGRESS WEIGHTED_ELEMENTS MONOCHROMATIC_IMAGE SMALL_IMAGE">
    <BoundingOval x="0" y="0" width="${WIDTH}" height="${HEIGHT}" outlinePadding="2" />
    ${DEFAULT_PROVIDER_POLICY}

    <!-- A slot nobody has filled draws nothing, not even its ring, so the scenery shows through. -->
    <Complication type="EMPTY">
    </Complication>

    <!-- A short string with an optional qualifier or icon. E.g. an alarm, a temperature. -->
    <Complication type="SHORT_TEXT">
        <Group name="ShortText" x="0" y="0" width="${WIDTH}" height="${HEIGHT}">
            ${BACKGROUND_GROUP}
            <Condition>
                <Expressions>
                    <Expression name="icon_and_text"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null && [COMPLICATION.TEXT] != null]]></Expression>
                    <Expression name="text_and_title"><![CDATA[[COMPLICATION.TEXT] != null && [COMPLICATION.TITLE] != null]]></Expression>
                    <Expression name="icon_and_title"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null && [COMPLICATION.TITLE] != null]]></Expression>
                    <Expression name="text">[COMPLICATION.TEXT] != null</Expression>
                    <Expression name="title">[COMPLICATION.TITLE] != null</Expression>
                    <Expression name="icon">[COMPLICATION.MONOCHROMATIC_IMAGE] != null</Expression>
                </Expressions>
                <Compare expression="icon_and_text">
                    <com.xlythe.ComplicationImage source="MONOCHROMATIC_IMAGE" area="icon_beside" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="text_beside" scale="medium" autoSizeScale="large" weight="MEDIUM" />
                </Compare>
                <Compare expression="text_and_title">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="value" scale="medium" autoSizeScale="large" weight="MEDIUM" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TITLE]" area="label" scale="small" dim="true" />
                </Compare>
                <Compare expression="icon_and_title">
                    <com.xlythe.ComplicationImage source="MONOCHROMATIC_IMAGE" area="icon_beside" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TITLE]" area="text_beside" scale="medium" autoSizeScale="large" />
                </Compare>
                <Compare expression="text">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="text" scale="large" weight="MEDIUM" />
                </Compare>
                <Compare expression="title">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TITLE]" area="text" scale="large" />
                </Compare>
                <Compare expression="icon">
                    <com.xlythe.ComplicationImage source="MONOCHROMATIC_IMAGE" area="glyph" />
                </Compare>
            </Condition>
        </Group>
    </Complication>

    <!--
        A longer string, so the type is smaller and allowed to wrap. This is the one type that may
        be handed a small image as well as an icon, and Wear's guidance is to show only one of them.
    -->
    <Complication type="LONG_TEXT">
        <Group name="LongText" x="0" y="0" width="${WIDTH}" height="${HEIGHT}">
            ${BACKGROUND_GROUP}
            <Condition>
                <Expressions>
                    <Expression name="title_and_text"><![CDATA[[COMPLICATION.TITLE] != null && [COMPLICATION.TEXT] != null]]></Expression>
                    <Expression name="icon_and_text"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null && [COMPLICATION.TEXT] != null]]></Expression>
                    <Expression name="image_and_text"><![CDATA[[COMPLICATION.SMALL_IMAGE] != null && [COMPLICATION.TEXT] != null]]></Expression>
                    <Expression name="text">[COMPLICATION.TEXT] != null</Expression>
                    <Expression name="title">[COMPLICATION.TITLE] != null</Expression>
                </Expressions>
                <Compare expression="title_and_text">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TITLE]" area="header" scale="small" dim="true" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="body" scale="small" autoSizeScale="medium" maxLines="2" />
                </Compare>
                <Compare expression="icon_and_text">
                    <com.xlythe.ComplicationImage source="MONOCHROMATIC_IMAGE" area="icon_beside" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="text_beside" scale="small" maxLines="2" />
                </Compare>
                <Compare expression="image_and_text">
                    <com.xlythe.ComplicationImage source="SMALL_IMAGE" area="icon_beside" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="text_beside" scale="small" maxLines="2" />
                </Compare>
                <Compare expression="text">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="text" scale="medium" maxLines="2" />
                </Compare>
                <Compare expression="title">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TITLE]" area="text" scale="medium" maxLines="2" />
                </Compare>
            </Condition>
        </Group>
    </Complication>

    <!--
        A number between a minimum and a maximum, so the ring is a gauge and the slot's own ring is
        its track. E.g. a battery, a workout. A provider that sends a colour ramp gets it laid over
        the whole range, with the part the value has not reached shaded, so the fill ends in the
        colour of the reading.

        A provider that sends no text still sent a number, so the gauge says what it is as a
        percentage rather than leaving the ring to be read off by eye. numberFormat takes a
        DecimalFormat pattern, and a '%' in one multiplies by a hundred and appends the sign.
    -->
    <Complication type="RANGED_VALUE">
        <Group name="RangedValue" x="0" y="0" width="${WIDTH}" height="${HEIGHT}">
            ${BACKGROUND_GROUP}
            <com.xlythe.ComplicationArc kind="ranged" />
            <Condition>
                <Expressions>
                    <Expression name="icon_and_text"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null && [COMPLICATION.TEXT] != null]]></Expression>
                    <Expression name="text_and_title"><![CDATA[[COMPLICATION.TEXT] != null && [COMPLICATION.TITLE] != null]]></Expression>
                    <Expression name="text">[COMPLICATION.TEXT] != null</Expression>
                    <Expression name="icon">[COMPLICATION.MONOCHROMATIC_IMAGE] != null</Expression>
                </Expressions>
                <Compare expression="icon_and_text">
                    <com.xlythe.ComplicationImage source="MONOCHROMATIC_IMAGE" area="icon_beside" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="text_beside" scale="medium" weight="MEDIUM" />
                </Compare>
                <Compare expression="text_and_title">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="value" scale="medium" weight="MEDIUM" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TITLE]" area="label" scale="small" dim="true" />
                </Compare>
                <Compare expression="text">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="text" scale="medium" weight="MEDIUM" />
                </Compare>
                <Compare expression="icon">
                    <com.xlythe.ComplicationImage source="MONOCHROMATIC_IMAGE" area="icon" />
                </Compare>
                <Default>
                    <com.xlythe.ComplicationText expression="numberFormat(&quot;#%&quot;, clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1))" area="text" scale="medium" weight="MEDIUM" />
                </Default>
            </Condition>
        </Group>
    </Complication>

    <!--
        A number counting up towards a target it is allowed to pass. E.g. a step count. A goal that
        has been passed keeps its full ring and draws the lap past it thicker, over the top.

        Where a ranged value is a proportion, a goal is a tally, so a provider that sends no text
        gets its own number back with thousands separated rather than a percentage of a target it
        may already be past.
    -->
    <Complication type="GOAL_PROGRESS">
        <Group name="GoalProgress" x="0" y="0" width="${WIDTH}" height="${HEIGHT}">
            ${BACKGROUND_GROUP}
            <com.xlythe.ComplicationArc kind="goal" />
            <Condition>
                <Expressions>
                    <Expression name="icon_and_text"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null && [COMPLICATION.TEXT] != null]]></Expression>
                    <Expression name="text_and_title"><![CDATA[[COMPLICATION.TEXT] != null && [COMPLICATION.TITLE] != null]]></Expression>
                    <Expression name="text">[COMPLICATION.TEXT] != null</Expression>
                    <Expression name="icon">[COMPLICATION.MONOCHROMATIC_IMAGE] != null</Expression>
                </Expressions>
                <Compare expression="icon_and_text">
                    <com.xlythe.ComplicationImage source="MONOCHROMATIC_IMAGE" area="icon_beside" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="text_beside" scale="medium" weight="MEDIUM" />
                </Compare>
                <Compare expression="text_and_title">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="value" scale="medium" weight="MEDIUM" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TITLE]" area="label" scale="small" dim="true" />
                </Compare>
                <Compare expression="text">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="text" scale="medium" weight="MEDIUM" />
                </Compare>
                <Compare expression="icon">
                    <com.xlythe.ComplicationImage source="MONOCHROMATIC_IMAGE" area="icon" />
                </Compare>
                <Default>
                    <com.xlythe.ComplicationText expression="numberFormat(&quot;#,###&quot;, [COMPLICATION.GOAL_PROGRESS_VALUE])" area="text" scale="medium" weight="MEDIUM" />
                </Default>
            </Condition>
        </Group>
    </Complication>

    <!--
        A list of things and how much of the whole each one is, drawn as one ring divided between
        them with a gap at each division. E.g. a week's sleep stages, a day's activity split.
    -->
    <Complication type="WEIGHTED_ELEMENTS">
        <Group name="WeightedElements" x="0" y="0" width="${WIDTH}" height="${HEIGHT}">
            <com.xlythe.ComplicationArc kind="weighted" />
            <Condition>
                <Expressions>
                    <Expression name="text_and_title"><![CDATA[[COMPLICATION.TEXT] != null && [COMPLICATION.TITLE] != null]]></Expression>
                    <Expression name="text">[COMPLICATION.TEXT] != null</Expression>
                    <Expression name="icon">[COMPLICATION.MONOCHROMATIC_IMAGE] != null</Expression>
                </Expressions>
                <Compare expression="text_and_title">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="value" scale="medium" weight="MEDIUM" />
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TITLE]" area="label" scale="small" dim="true" />
                </Compare>
                <Compare expression="text">
                    <com.xlythe.ComplicationText expression="[COMPLICATION.TEXT]" area="text" scale="medium" weight="MEDIUM" />
                </Compare>
                <Compare expression="icon">
                    <com.xlythe.ComplicationImage source="MONOCHROMATIC_IMAGE" area="icon" />
                </Compare>
            </Condition>
        </Group>
    </Complication>

    <!--
        A single-color glyph and nothing else, so it gets the room the ring leaves and takes the
        slot's color.
    -->
    <Complication type="MONOCHROMATIC_IMAGE">
        <Group name="MonochromaticImage" x="0" y="0" width="${WIDTH}" height="${HEIGHT}">
            ${BACKGROUND_GROUP}
            <com.xlythe.ComplicationImage source="MONOCHROMATIC_IMAGE" area="glyph" />
        </Group>
    </Complication>

    <!--
        An image that carries its own color, so it is not tinted. The provider says whether it is a
        photograph, which should fill what room there is, or an icon, which should not be crowded:
        IMAGE_STYLE is 1 for a photo and 2 for an icon.
    -->
    <Complication type="SMALL_IMAGE">
        <Group name="SmallImage" x="0" y="0" width="${WIDTH}" height="${HEIGHT}">
            ${BACKGROUND_GROUP}
            <Condition>
                <Expressions>
                    <Expression name="photo">[COMPLICATION.IMAGE_STYLE] == 1</Expression>
                </Expressions>
                <Compare expression="photo">
                    <com.xlythe.ComplicationImage source="SMALL_IMAGE" area="photo" />
                </Compare>
                <Default>
                    <com.xlythe.ComplicationImage source="SMALL_IMAGE" area="glyph" />
                </Default>
            </Condition>
        </Group>
    </Complication>
</ComplicationSlot>
