<ItemList>
    <!--
        Helper variables bundled with com.xlythe.watchface-format (enable with standardVariables = true).
        ${LATITUDE} and ${LONGITUDE} are generated from the watch's time zone.
        Variables declared by the watch face override these.
    -->
    <Item name="${IS_SUNRISE}">
        <!-- Sunrise is defined as -1hr / +1hr from exact sunrise -->
        <![CDATA[
            ${CURRENT_MILLIS_TO_THE_MINUTE} >= (${SUNRISE_MILLIS_SINCE_MIDNIGHT} - 3600000)
            && ${CURRENT_MILLIS_TO_THE_MINUTE} <= (${SUNRISE_MILLIS_SINCE_MIDNIGHT} + 3600000)
        ]]>
    </Item>
    <Item name="${IS_DAY}">
        <!-- Day is defined as +1hr from exact sunrise and -1hr from exact sunset -->
        <![CDATA[
            ${CURRENT_MILLIS_TO_THE_MINUTE} > (${SUNRISE_MILLIS_SINCE_MIDNIGHT} + 3600000)
            && ${CURRENT_MILLIS_TO_THE_MINUTE} < (${SUNSET_MILLIS_SINCE_MIDNIGHT} - 3600000)
        ]]>
    </Item>
    <Item name="${IS_SUNSET}">
        <!-- Sunset is defined as -1hr / +1hr from exact sunset -->
        <![CDATA[
            ${CURRENT_MILLIS_TO_THE_MINUTE} >= (${SUNSET_MILLIS_SINCE_MIDNIGHT} - 3600000)
            && ${CURRENT_MILLIS_TO_THE_MINUTE} <= (${SUNSET_MILLIS_SINCE_MIDNIGHT} + 3600000)
        ]]>
    </Item>
    <Item name="${IS_NIGHT}">
        <!-- Night is defined as -1hr from exact sunrise or +1hr from exact sunset -->
        <![CDATA[
            ${CURRENT_MILLIS_TO_THE_MINUTE} < (${SUNRISE_MILLIS_SINCE_MIDNIGHT} - 3600000)
            || ${CURRENT_MILLIS_TO_THE_MINUTE} > (${SUNSET_MILLIS_SINCE_MIDNIGHT} + 3600000)
        ]]>
    </Item>
    <Item name="${IS_TRANSITIONING_OVER_DAY}">
        <!-- Day is defined as sunrise_time <= current_hour < sunset_time  -->
        <![CDATA[
            ${CURRENT_MILLIS_TO_THE_MINUTE} >= ${SUNRISE_MILLIS_SINCE_MIDNIGHT}
            && ${CURRENT_MILLIS_TO_THE_MINUTE} < ${SUNSET_MILLIS_SINCE_MIDNIGHT}
        ]]>
    </Item>
    <!-- Only true during sunrise/sunset. 2hr-1hr before sunrise ends, 1hr-0hr before sunset ends. -->
    <Item name="${IS_TRANSITIONING_OVER_NIGHT}">
        <!-- Night is defined as current_hour < sunrise_time or sunset_time <= current_hour  -->
        <![CDATA[
            ${CURRENT_MILLIS_TO_THE_MINUTE} < ${SUNRISE_MILLIS_SINCE_MIDNIGHT}
            || ${CURRENT_MILLIS_TO_THE_MINUTE} >= ${SUNSET_MILLIS_SINCE_MIDNIGHT}
        ]]>
    </Item>
    <!--
        Calculates the alpha (0-255) for the foreground as we transition between Night -> Sunrise -> Day -> Sunset -> Night
    -->
    <!--
        Every branch clamps the same way and differs only in which edge it measures to and which
        way round, so the clamp is written once and the sign is chosen instead. "Until" is just
        "since" negated, which is what lets the two halves share one subtraction.

        abs() would be shorter still and is not the same thing. Each half has to keep its own
        test, because which side of the edge we are on decides the sign, and the answers at the
        far end of the night depend on the difference going negative rather than growing.
    -->
    <Item name="${GET_TRANSITION_ALPHA}">
        clamp(255 * (1 - ((${IS_SUNRISE}) ?
            (${MILLIS_SINCE_SUNRISE} * ((${IS_TRANSITIONING_OVER_NIGHT}) ? -1 : 1)) :
            (${MILLIS_SINCE_SUNSET} * ((${IS_TRANSITIONING_OVER_DAY}) ? -1 : 1))) / 3600000), 0, 255)
    </Item>
    <!--
        Returns the time in millis since 12:00am.

        Reading this puts an expression on the every-second path: an expression is re-evaluated
        whenever any source in it changes, and [SECOND] changes every second. Anything that only
        needs to know roughly when it is - which is everything astronomical below - should read
        ${CURRENT_MILLIS_TO_THE_MINUTE} instead.
    -->
    <Item name="${CURRENT_MILLIS_SINCE_MIDNIGHT}">
        ([HOUR_0_23] * 3600000) + ([MINUTE] * 60000) + ([SECOND] * 1000) + [MILLISECOND]
    </Item>
    <!--
        The same thing to the minute. The sun moves a quarter of a degree in that time and the
        moon a fifth of one, so nothing here can tell the difference, and it keeps the whole
        chain off the per-second path.
    -->
    <Item name="${CURRENT_MILLIS_TO_THE_MINUTE}">
        ([HOUR_0_23] * 3600000) + ([MINUTE] * 60000)
    </Item>

    <!-- Copied from https://gml.noaa.gov/grad/solcalc/calcdetails.html -->
    <!-- Percent (0.0 to 1.0) into the current day. -->
    <Item name="${TIME_PAST_LOCAL_MIDNIGHT}">
        ${CURRENT_MILLIS_TO_THE_MINUTE} / 86400000
    </Item>
    <!--
        The UTC offset in hours, including daylight saving.

        Looked up from the time zone table rather than measured, because measuring it means
        subtracting [UTC_TIMESTAMP], and a source that changes every millisecond re-evaluates
        everything holding it on every frame. [TIMEZONE_ID] changes when you fly somewhere and
        [IS_DAYLIGHT_SAVING_TIME] twice a year, so this costs nothing to keep up to date.

        [TIMEZONE_OFFSET] has been readable since format 1 and is no use: it returns "+1:30"
        rather than 90, and arithmetic on text evaluates to nothing. Format 3 has
        [TIMEZONE_OFFSET_MINUTES], which the plugin switches to - see StandardDates - since it
        knows every zone rather than the ones in the table.

        A zone the table doesn't carry falls back to UTC, which is what it did before.
    -->
    <Item name="${LOCAL_OFFSET}">
        (${TIMEZONE_STANDARD_OFFSET_MINUTES} + ([IS_DAYLIGHT_SAVING_TIME] ? ${TIMEZONE_DAYLIGHT_MINUTES} : 0)) / 60
    </Item>
    <!--
        Counted from the calendar, which is dearer to write than [UTC_TIMESTAMP] / 86400000 and
        far cheaper to run. An expression is re-evaluated whenever a source in it changes, and a
        timestamp in milliseconds changes as fast as the runtime can ask; [YEAR], [DAY_OF_YEAR]
        and the minute clock do not. ${JULIAN_CENTURY} is read nineteen times, so this is what
        decides whether the sun is worked out once a minute or once a frame.

        The century rules cancel: floor((y-1)/100) - floor((y-1)/400) is 15 for every year from
        1901 to 2100, so two of the three floors fold into the constant.

        This is local, not UTC. NOAA subtracts the offset here; leaving it out moves sunrise and
        sunset by a minute or two, which is the trade this file has always made. The moon cannot
        make it - see ${JULIAN_DAY_UTC}.

        The plugin replaces both of these with [MINUTES_SINCE_EPOCH] on format 3 and up, where
        one source is exact, in UTC, and still only changes once a minute.
    -->
    <Item name="${JULIAN_DAY}">
        1721410.5 + 365 * ([YEAR] - 1) + floor(([YEAR] - 1) / 4) + [DAY_OF_YEAR] - 1 + ${TIME_PAST_LOCAL_MIDNIGHT}
    </Item>
    <!--
        The same day in UTC, which sidereal time needs and only the moon reads. An hour of offset
        turns the earth 15 degrees, so a local date would put the moon three quarters of the sky
        away in a place like UTC+5 - the error the sun shrugs off is the one the moon cannot.

        Taking the offset off the local day rather than reading [UTC_TIMESTAMP] keeps the moon on
        the same slow sources as everything else. It is only as good as the zone table, which is
        good to the minute, and the moon moves a fifth of a degree in one.
    -->
    <Item name="${JULIAN_DAY_UTC}">
        ${JULIAN_DAY} - ${LOCAL_OFFSET} / 24
    </Item>
    <Item name="${JULIAN_CENTURY}">
        (${JULIAN_DAY} - 2451545) / 36525
    </Item>
    <Item name="${JULIAN_CENTURY_UTC}">
        (${JULIAN_DAY_UTC} - 2451545) / 36525
    </Item>
    <Item name="${GEOM_MEAN_LONG_SUN_DEG}">
        (280.46646 + ${JULIAN_CENTURY} * (36000.76983 + ${JULIAN_CENTURY} * 0.0003032)) % 360
    </Item>
    <Item name="${GEOM_MEAN_ANOM_SUN_DEG}">
        357.52911 + ${JULIAN_CENTURY} * (35999.05029 - 0.0001537 * ${JULIAN_CENTURY})
    </Item>
    <Item name="${ECCENT_EARTH_ORBIT}">
        0.016708634 - ${JULIAN_CENTURY} * (0.000042037 + 0.0000001267 * ${JULIAN_CENTURY})
    </Item>
    <Item name="${SUN_EQ_OF_CTR}">
        sin(rad(${GEOM_MEAN_ANOM_SUN_DEG})) * (1.914602 - ${JULIAN_CENTURY} * (0.004817 + 0.000014 * ${JULIAN_CENTURY})) + sin(rad(2 * ${GEOM_MEAN_ANOM_SUN_DEG})) * (0.019993 - 0.000101 * ${JULIAN_CENTURY}) + sin(rad(3 * ${GEOM_MEAN_ANOM_SUN_DEG})) * 0.000289
    </Item>
    <Item name="${SUN_TRUE_LONG_DEG}">
        ${GEOM_MEAN_LONG_SUN_DEG} + ${SUN_EQ_OF_CTR}
    </Item>
    <Item name="${SUN_APP_LONG_DEG}">
        ${SUN_TRUE_LONG_DEG} - 0.00569 - 0.00478 * sin(rad(125.04 - 1934.136 * ${JULIAN_CENTURY}))
    </Item>
    <Item name="${MEAN_OBLIQ_ECLIPTIC_DEG}">
        23 + (26 + ((21.448 - ${JULIAN_CENTURY} * (46.815 + ${JULIAN_CENTURY} * (0.00059 - ${JULIAN_CENTURY} * 0.001813)))) / 60) / 60
    </Item>
    <Item name="${OBLIQ_CORR_DEG}">
        ${MEAN_OBLIQ_ECLIPTIC_DEG} + 0.00256 * cos(rad(125.04 - 1934.136 * ${JULIAN_CENTURY}))
    </Item>
    <Item name="${SUN_DECLIN_DEG}">
        deg(asin(sin(rad(${OBLIQ_CORR_DEG})) * sin(rad(${SUN_APP_LONG_DEG}))))
    </Item>
    <Item name="${VAR_Y}">
        tan(rad(${OBLIQ_CORR_DEG} / 2)) * tan(rad(${OBLIQ_CORR_DEG} / 2))
    </Item>
    <Item name="${EQ_OF_TIME_MINUTES}">
        4 * deg(${VAR_Y} * sin(2 * rad(${GEOM_MEAN_LONG_SUN_DEG})) - 2 * ${ECCENT_EARTH_ORBIT} * sin(rad(${GEOM_MEAN_ANOM_SUN_DEG})) + 4 * ${ECCENT_EARTH_ORBIT} * ${VAR_Y} * sin(rad(${GEOM_MEAN_ANOM_SUN_DEG})) * cos(2 * rad(${GEOM_MEAN_LONG_SUN_DEG})) - 0.5 * ${VAR_Y} * ${VAR_Y} * sin(4 * rad(${GEOM_MEAN_LONG_SUN_DEG})) - 1.25 * ${ECCENT_EARTH_ORBIT} * ${ECCENT_EARTH_ORBIT} * sin(2 * rad(${GEOM_MEAN_ANOM_SUN_DEG})))
    </Item>
    <Item name="${HA_SUNRISE_DEG}">
        deg(acos(cos(rad(90.833)) / (cos(rad(${LATITUDE})) * cos(rad(${SUN_DECLIN_DEG}))) - tan(rad(${LATITUDE})) * tan(rad(${SUN_DECLIN_DEG}))))
    </Item>
    <!-- Returns the time of high noon from 0.0 to 1.0 as a percent of the day. Wrapped, since ${LOCAL_OFFSET} may be a day off. -->
    <Item name="${SOLAR_NOON_LST}">
        ((((720 - 4 * ${LONGITUDE} - ${EQ_OF_TIME_MINUTES} + ${LOCAL_OFFSET} * 60) / 1440) % 1) + 1) % 1
    </Item>
    <!-- Returns the sunrise time from 0.0 to 1.0 as a percent of the day. -->
    <Item name="${SUNRISE_TIME_LST}">
        ${SOLAR_NOON_LST} - ${HA_SUNRISE_DEG} * 4 / 1440
    </Item>
    <!-- Returns the sunset time from 0.0 to 1.0 as a percent of the day. -->
    <Item name="${SUNSET_TIME_LST}">
        ${SOLAR_NOON_LST} + ${HA_SUNRISE_DEG} * 4 / 1440
    </Item>
    <!-- Returns the sunrise time in millis since 12:00am. Assumes we are currently in sunrise. -->
    <Item name="${SUNRISE_MILLIS_SINCE_MIDNIGHT}">
        86400000 * ${SUNRISE_TIME_LST}
    </Item>
    <!-- Returns the sunset time in millis since 12:00am. Assumes we are currently in sunset. -->
    <Item name="${SUNSET_MILLIS_SINCE_MIDNIGHT}">
        86400000 * ${SUNSET_TIME_LST}
    </Item>

    <!-- Returns the time in millis until exactly sunrise. -->
    <Item name="${MILLIS_UNTIL_SUNRISE}">
        ${SUNRISE_MILLIS_SINCE_MIDNIGHT} - ${CURRENT_MILLIS_TO_THE_MINUTE}
    </Item>
    <!-- Returns the time in millis since exactly sunrise. -->
    <Item name="${MILLIS_SINCE_SUNRISE}">
        ${CURRENT_MILLIS_TO_THE_MINUTE} - ${SUNRISE_MILLIS_SINCE_MIDNIGHT}
    </Item>
    <!-- Returns the time in millis until exactly sunset. -->
    <Item name="${MILLIS_UNTIL_SUNSET}">
        ${SUNSET_MILLIS_SINCE_MIDNIGHT} - ${CURRENT_MILLIS_TO_THE_MINUTE}
    </Item>
    <!-- Returns the time in millis since exactly sunset. -->
    <Item name="${MILLIS_SINCE_SUNSET}">
        ${CURRENT_MILLIS_TO_THE_MINUTE} - ${SUNSET_MILLIS_SINCE_MIDNIGHT}
    </Item>
    <!-- Returns the length of day in millis. -->
    <Item name="${DAY_LENGTH_MILLIS}">
        ${SUNSET_MILLIS_SINCE_MIDNIGHT} - ${SUNRISE_MILLIS_SINCE_MIDNIGHT}
    </Item>
    <!-- Returns the length of night in millis. -->
    <Item name="${NIGHT_LENGTH_MILLIS}">
        ${SUNRISE_MILLIS_SINCE_MIDNIGHT} + 86400000 - ${SUNSET_MILLIS_SINCE_MIDNIGHT}
    </Item>
    <!--
        The two night branches are the same measurement a day apart: before midnight the clock is
        already past sunset, after midnight it needs a day adding before the subtraction makes
        sense. Adding the day conditionally says that once instead of twice, and the divide by
        the night's length comes out of both branches.
    -->
    <Item name="${PERCENT_OF_DAY}">
        (${IS_TRANSITIONING_OVER_DAY}) ?
            ((${CURRENT_MILLIS_TO_THE_MINUTE} - ${SUNRISE_MILLIS_SINCE_MIDNIGHT}) / ${DAY_LENGTH_MILLIS}) :
            ((${MILLIS_SINCE_SUNSET} + ((${CURRENT_MILLIS_TO_THE_MINUTE} >= ${SUNSET_MILLIS_SINCE_MIDNIGHT}) ? 0 : 86400000)) / ${NIGHT_LENGTH_MILLIS})
    </Item>
    <!--
        [MOON_PHASE_TYPE]
        0 - NEW_MOON
        1 - WAXING_CRESCENT_MOON
        2 - FIRST_QUARTER_MOON
        3 - WAXING_GIBBOUS_MOON
        4 - FULL_MOON
        5 - WANING_GIBBOUS_MOON
        6 - THIRD_QUARTER_MOON
        7 - WANING_CRESCENT_MOON
    -->
    <Item name="${IS_MOON_NEW}">[MOON_PHASE_TYPE]==0</Item>
    <Item name="${IS_MOON_WAXING_CRESCENT}">[MOON_PHASE_TYPE]==1</Item>
    <Item name="${IS_MOON_FIRST_QUARTER}">[MOON_PHASE_TYPE]==2</Item>
    <Item name="${IS_MOON_WAXING_GIBBOUS}">[MOON_PHASE_TYPE]==3</Item>
    <Item name="${IS_MOON_FULL}">[MOON_PHASE_TYPE]==4</Item>
    <Item name="${IS_MOON_WANING_GIBBOUS}">[MOON_PHASE_TYPE]==5</Item>
    <Item name="${IS_MOON_THIRD_QUARTER}">[MOON_PHASE_TYPE]==6</Item>
    <Item name="${IS_MOON_WANING_CRESCENT}">[MOON_PHASE_TYPE]==7</Item>

    <!--
        Where the moon actually is in the sky, as an altitude above the horizon and an azimuth
        measured east from north. The platform has no source for this - [MOON_PHASE_POSITION] is
        a position through the phases, not across the sky - so it's worked out here.

        Meeus, Astronomical Algorithms, chapter 47, keeping the terms worth more than a tenth of
        a degree. The moon is half a degree wide, so the answer lands within about a moon of the
        real one, which is as much as a drawing of it can show.
    -->
    <!-- The moon's mean elements. Wrapped to a turn so a single-precision evaluator keeps its digits. -->
    <Item name="${MOON_MEAN_LONGITUDE_DEG}">
        (218.3164477 + 481267.88123421 * ${JULIAN_CENTURY_UTC}) % 360
    </Item>
    <Item name="${MOON_MEAN_ELONGATION_DEG}">
        (297.8501921 + 445267.1114034 * ${JULIAN_CENTURY_UTC}) % 360
    </Item>
    <Item name="${MOON_MEAN_ANOMALY_DEG}">
        (134.9633964 + 477198.8675055 * ${JULIAN_CENTURY_UTC}) % 360
    </Item>
    <Item name="${MOON_ARG_LATITUDE_DEG}">
        (93.2720950 + 483202.0175233 * ${JULIAN_CENTURY_UTC}) % 360
    </Item>

    <Item name="${MOON_ECLIPTIC_LONGITUDE_DEG}">
        ${MOON_MEAN_LONGITUDE_DEG} + 6.289 * sin(rad(${MOON_MEAN_ANOMALY_DEG})) + 1.274 * sin(rad(2 * ${MOON_MEAN_ELONGATION_DEG} - ${MOON_MEAN_ANOMALY_DEG})) + 0.658 * sin(rad(2 * ${MOON_MEAN_ELONGATION_DEG})) + 0.214 * sin(rad(2 * ${MOON_MEAN_ANOMALY_DEG})) - 0.186 * sin(rad(${GEOM_MEAN_ANOM_SUN_DEG})) - 0.114 * sin(rad(2 * ${MOON_ARG_LATITUDE_DEG}))
    </Item>
    <Item name="${MOON_ECLIPTIC_LATITUDE_DEG}">
        5.128 * sin(rad(${MOON_ARG_LATITUDE_DEG})) + 0.281 * sin(rad(${MOON_MEAN_ANOMALY_DEG} + ${MOON_ARG_LATITUDE_DEG})) - 0.278 * sin(rad(${MOON_ARG_LATITUDE_DEG} - ${MOON_MEAN_ANOMALY_DEG})) - 0.173 * sin(rad(2 * ${MOON_MEAN_ELONGATION_DEG} - ${MOON_ARG_LATITUDE_DEG}))
    </Item>

    <!-- Ecliptic to equatorial, tilting by the same obliquity the sun uses. -->
    <Item name="${MOON_DECLINATION_DEG}">
        deg(asin(sin(rad(${MOON_ECLIPTIC_LATITUDE_DEG})) * cos(rad(${OBLIQ_CORR_DEG})) + cos(rad(${MOON_ECLIPTIC_LATITUDE_DEG})) * sin(rad(${OBLIQ_CORR_DEG})) * sin(rad(${MOON_ECLIPTIC_LONGITUDE_DEG}))))
    </Item>
    <!--
        Right ascension. There is no atan2, so this is the arc cosine of the x component over
        cos(declination), turned into the other half of the circle when the y component is
        negative - which is what atan2 would have done with the pair.
    -->
    <Item name="${MOON_RIGHT_ASCENSION_DEG}">
        ((cos(rad(${MOON_ECLIPTIC_LATITUDE_DEG})) * sin(rad(${MOON_ECLIPTIC_LONGITUDE_DEG})) * cos(rad(${OBLIQ_CORR_DEG})) - sin(rad(${MOON_ECLIPTIC_LATITUDE_DEG})) * sin(rad(${OBLIQ_CORR_DEG}))) >= 0) ? deg(acos(clamp(cos(rad(${MOON_ECLIPTIC_LATITUDE_DEG})) * cos(rad(${MOON_ECLIPTIC_LONGITUDE_DEG})) / cos(rad(${MOON_DECLINATION_DEG})), -1, 1))) : (360 - deg(acos(clamp(cos(rad(${MOON_ECLIPTIC_LATITUDE_DEG})) * cos(rad(${MOON_ECLIPTIC_LONGITUDE_DEG})) / cos(rad(${MOON_DECLINATION_DEG})), -1, 1))))
    </Item>

    <!-- How far the earth has turned, which is what puts the moon east or west of the meridian. -->
    <Item name="${GREENWICH_SIDEREAL_TIME_DEG}">
        (((280.46061837 + 360.98564736629 * (${JULIAN_DAY_UTC} - 2451545)) % 360) + 360) % 360
    </Item>
    <Item name="${MOON_HOUR_ANGLE_DEG}">
        (((${GREENWICH_SIDEREAL_TIME_DEG} + ${LONGITUDE} - ${MOON_RIGHT_ASCENSION_DEG}) % 360) + 360) % 360
    </Item>

    <!-- Above the horizon is positive, below is negative. -->
    <Item name="${MOON_ALTITUDE_DEG}">
        deg(asin(clamp(sin(rad(${LATITUDE})) * sin(rad(${MOON_DECLINATION_DEG})) + cos(rad(${LATITUDE})) * cos(rad(${MOON_DECLINATION_DEG})) * cos(rad(${MOON_HOUR_ANGLE_DEG})), -1, 1)))
    </Item>
    <!-- Measured east from north, so 90 is due east and 180 is due south. -->
    <Item name="${MOON_AZIMUTH_DEG}">
        (sin(rad(${MOON_HOUR_ANGLE_DEG})) > 0) ? (360 - deg(acos(clamp((sin(rad(${MOON_DECLINATION_DEG})) - sin(rad(${MOON_ALTITUDE_DEG})) * sin(rad(${LATITUDE}))) / (cos(rad(${MOON_ALTITUDE_DEG})) * cos(rad(${LATITUDE}))), -1, 1)))) : deg(acos(clamp((sin(rad(${MOON_DECLINATION_DEG})) - sin(rad(${MOON_ALTITUDE_DEG})) * sin(rad(${LATITUDE}))) / (cos(rad(${MOON_ALTITUDE_DEG})) * cos(rad(${LATITUDE}))), -1, 1)))
    </Item>
    <Item name="${IS_MOON_UP}">
        <![CDATA[${MOON_ALTITUDE_DEG} > 0]]>
    </Item>
    <!--
        [WEATHER.CONDITION]
        0 - UNKNOWN_VALUE
        1 - CLEAR
        2 - CLOUDY
        3 - FOG
        4 - HEAVY_RAIN
        5 - HEAVY_SNOW
        6 - RAIN
        7 - SNOW
        8 - SUNNY
        9 - THUNDERSTORM
        10 - SLEET
        11 - LIGHT_SNOW
        12 - LIGHT_RAIN
        13 - MIST
        14 - PARTLY_CLOUDY
        15 - WINDY
    -->
    <Item name="${IS_WEATHER_CLEAR}">
        <![CDATA[
            ![WEATHER.IS_AVAILABLE]
            || ([WEATHER.IS_AVAILABLE]
                && ([WEATHER.CONDITION]==0
                || [WEATHER.CONDITION]==1
                || [WEATHER.CONDITION]==8
                || [WEATHER.CONDITION]==15))
        ]]>
    </Item>
    <Item name="${IS_WEATHER_CLOUDY}">
        <![CDATA[
            [WEATHER.IS_AVAILABLE]
                && ([WEATHER.CONDITION]==2
                || [WEATHER.CONDITION]==3
                || [WEATHER.CONDITION]==13
                || [WEATHER.CONDITION]==14)
        ]]>
    </Item>
    <Item name="${IS_WEATHER_RAINY}">
        <![CDATA[
            [WEATHER.IS_AVAILABLE]
                && ([WEATHER.CONDITION]==4
                || [WEATHER.CONDITION]==6
                || [WEATHER.CONDITION]==9
                || [WEATHER.CONDITION]==12)
        ]]>
    </Item>
    <Item name="${IS_WEATHER_SNOWY}">
        <![CDATA[
            [WEATHER.IS_AVAILABLE]
                && ([WEATHER.CONDITION]==5
                || [WEATHER.CONDITION]==7
                || [WEATHER.CONDITION]==10
                || [WEATHER.CONDITION]==11)
        ]]>
    </Item>
</ItemList>
